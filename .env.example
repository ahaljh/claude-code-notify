# Slack (두 키가 모두 있어야 활성화)
SLACK_BOT_TOKEN=<user-slack-bot-token>
USER_ID=<user-slack-id> # 주의 : user name이 아니라 user id 입니다. (프로필에서 확인 가능, 대문자U로 시작하는 문자열)

# Discord (키가 있으면 활성화)
DISCORD_WEBHOOK_URL=<discord-webhook-url> # 채널 편집 > 연동 > 웹후크에서 복사

LOG_LEVEL=DEBUG # 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL). 미설정 시 기본값: DEBUG
